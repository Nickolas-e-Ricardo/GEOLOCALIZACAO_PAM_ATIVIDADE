<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppLibertadoresHAS.Views.Usuarios.CadastroView"
             Title="CadastroView">
    <VerticalStackLayout>
        <Entry Placeholder="Digite seu nome de usuário" Text ="{Binding Login}" 
    Margin="0,10,0,0" VerticalOptions="Fill" HorizontalOptions="Fill">
        </Entry>

        <Entry Placeholder="Digite a senha" Text="{Binding Senha}" IsPassword="True" 
     Margin="0,10,0,0" VerticalOptions="Fill" HorizontalOptions="Fill">
        </Entry>

        <Button Text="Registrar" Command="{Binding RegistrarCommand}" HorizontalOptions="Fill" Margin="0,10,0,0"/>

    </VerticalStackLayout>
</ContentPage>