<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppLibertadoresHAS.Views.Usuarios.LocalizacaoView"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:vm="clr-namespace:AppLibertadoresHAS.ViewModels"
             x:DataType="vm:LocalizacaoViewModel"
             Title="Mapa de usuários">

    <maps:Map x:Name="mapa" ItemsSource="{Binding Pins}"
            MapType="Hybrid"
            IsZoomEnabled="True" IsTrafficEnabled="True">
        <maps:Map.ItemTemplate>
            <DataTemplate x:DataType="maps:Pin">
                <maps:Pin Location="{Binding Location}"
                          Address="{Binding Address}"
                          Label="{Binding Label}"/>
            </DataTemplate>
        </maps:Map.ItemTemplate>
    </maps:Map>
</ContentPage>